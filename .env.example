# Point the wallet at another node. Defaults live in src/tor/config.ts:
#   primary  https://www.torblockchain.fun
#   fallback https://torblockchain.onrender.com
#
# Both are the same chain. The wallet proves it before signing: chain_id 072316
# and the pinned genesis hash must match on whichever host answers, or every
# signing button stays disabled with the failing rule on screen (#/security).
#
# VITE_TOR_API=https://www.torblockchain.fun
# VITE_TOR_API_FALLBACK=https://torblockchain.onrender.com
#
# Running your own node? See docs/NODE-SYNC.md, then:
# VITE_TOR_API=http://127.0.0.1:8090
#
# Optional marketplace engine (separate service, not part of the node):
# VITE_NFT_ENGINE=http://127.0.0.1:8792
#
# THERE IS DELIBERATELY NO AI KEY HERE.
# OpenRouter, OpenAI, Anthropic, Hugging Face and Venice keys are typed into the
# #/ai screen at runtime and kept in that tab's memory (sessionStorage at most,
# never localStorage). A VITE_ prefix would inline the key into
# dist/assets/*.js and hand it to every visitor — see SECURITY.md §3.
